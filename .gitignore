# ── 依赖与包管理器 ────────────────────────────────────────────────
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm-cache/

# ── 打包 / 构建产物 ──────────────────────────────────────────────
# npm pack 与 GitHub Action 生成的安装包；发布走 `files` 白名单，不依赖仓库跟踪。
*.tgz
*.tgz.sha256
dist/
lib/
*.tsbuildinfo

# ── 本地运行产物与日志 ───────────────────────────────────────────
*.log
logs/
coverage/
.nyc_output/
*.lcov

# ── 环境变量与密钥（不要提交） ───────────────────────────────────
.env
.env.*
!.env.example

# ── 编辑器与 IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── 操作系统 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 临时文件 ─────────────────────────────────────────────────────
tmp/
*.tmp
*.bak
*.orig
